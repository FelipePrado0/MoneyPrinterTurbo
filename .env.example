# Production server only: makes plain `docker compose up -d --build` use the
# production compose file.
COMPOSE_FILE=docker-compose.prod.yml

# Secrets injected at runtime; they win over config.toml and are never
# written back to it. Leave a line empty to keep the config.toml value.
MPT_LOGIN_SENHA=
MPT_OPENROUTER_API_KEY=
# Comma separated
MPT_PEXELS_API_KEYS=
MPT_PIXABAY_API_KEYS=
MPT_YOUTUBE_CLIENT_ID=
MPT_YOUTUBE_CLIENT_SECRET=
MPT_YOUTUBE_REFRESH_TOKEN=
TZ=America/Sao_Paulo
